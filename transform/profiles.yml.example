dataforge:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account-json
      project: "{{ env_var('BIGQUERY_PROJECT_ID') }}"
      dataset: crm_data_raw
      location: US
      threads: 4
      keyfile_json: "{{ from_json(env_var('BIGQUERY_KEYFILE_JSON')) }}"
      priority: interactive
      job_creation_timeout_seconds: 120
      job_execution_timeout_seconds: 600

    prod:
      type: bigquery
      method: service-account
      project: "{{ env_var('BIGQUERY_PROJECT_ID') }}"
      dataset: crm_data_raw
      location: US
      threads: 8
      keyfile: "{{ env_var('GOOGLE_APPLICATION_CREDENTIALS') }}"
      priority: batch
      job_creation_timeout_seconds: 300
      job_execution_timeout_seconds: 3600
